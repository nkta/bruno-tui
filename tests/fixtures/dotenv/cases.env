# Cas de lecture .env vérifiés contre dotenv.parse 16.6.1 (bru 2.13.2).
BASIC=basic
export EXPORTED=exported
export=export-as-key
   INDENTED   =   indented value   
COLON: colon-value
COLON_NOSPACE:nope
EMPTY=
EMPTY_THEN_NEXT=
NEXT=next
SINGLE='single # not comment'
DOUBLE="double\nwith newline"
BACKTICK=`back 'tick' "q"`
LITERAL_ESCAPE='single\nkept'
INLINE=value # comment
HASH_IN_DOUBLE="a # b"
MULTI="line one
line two"
UNCLOSED="unclosed
AFTER_UNCLOSED=after
ESCAPED_QUOTE="say \"hi\""
TRAILING_QUOTED="a" trailing
TWO_QUOTED="a" "b"
DOTTED.key-name=dotted
DUP=first
DUP=second
not a valid line
=novalue
EQUALS=a=b=c
QUOTE_THEN_COMMENT='x' # it's
SPACE_BEFORE_EQ =spaced
TAB_VALUE=	tabbed	
UNICODE=héllo wörld
