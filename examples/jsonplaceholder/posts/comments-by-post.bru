meta {
  name: Commentaires d'un article
  type: http
  seq: 3
}

get {
  url: {{base_url}}/comments?postId=1
  body: none
  auth: inherit
}

params:query {
  postId: 1
}

assert {
  res.status: eq 200
}

docs {
  Utilise `params:query` plutôt qu'un chemin imbriqué, pour vérifier
  l'affichage des paramètres de requête dans le détail.
}
